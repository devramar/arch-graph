{
  "ignored_paths": [],
  "layers": {
    "architecture": {
      "display_name": "Core Architecture",
      "path_root": "crates",
      "ignored_paths": [
        "archgraph-core/tests/fixtures/**"
      ],
      "files": [
        "ARCHITECTURE.md"
      ]
    },
    "desktop": {
      "display_name": "Desktop Architecture",
      "path_root": "apps/desktop",
      "ignored_paths": [],
      "files": [
        "ARCHITECTURE.md"
      ]
    }
  },
  "app_colours": {
    "colour_overrides": {
      "references": {},
      "subreferences": {}
    }
  },
  "default_view": "sticky",
  "view_settings": {
    "desktop": {
      "layer_groups": [
        {
          "id": "archgraph",
          "name": "ArchGraph",
          "enabled": true,
          "layer_ids": [
            "architecture",
            "desktop"
          ]
        }
      ]
    }
  }
}
