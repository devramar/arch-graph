{
  "aliasing": {
    "ARCHITECTURE.md": ["DOCUMENTATION.md"],
    "ARCH_NODE": ["SYS_NODE"],
    "ARCH_REFERENCE": ["SYS_REF", "ARCH_REF"],
    "ARCH_SUBREFERENCE": ["SYS_LOCAL"]
  },
  "app_colours": {
    "colour_overrides": {
      "references": {
        "Identity": "purple"
      },
      "subreferences": {
        "Password Management": "teal"
      }
    }
  },
  "default_view": "sticky",
  "view_settings": {
    "sticky": {
      "reference_distance": 190,
      "subreference_distance": 72
    }
  }
}
