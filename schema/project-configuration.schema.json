{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archgraph.dev/schema/project-configuration-v3.json",
  "title": "ArchGraph Project Configuration",
  "description": "Optional root .archgraph configuration consumed by archgraph-core.",
  "type": "object",
  "properties": {
    "ignored_paths": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/glob"
      },
      "uniqueItems": true,
      "description": "Project-root-relative glob patterns ignored by every layer."
    },
    "layers": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/layer"
      },
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^\\S+$"
      },
      "properties": {
        "architecture": {
          "$ref": "#/$defs/architectureLayer"
        }
      }
    },
    "app_colours": {
      "type": "object",
      "properties": {
        "colour_overrides": {
          "type": "object",
          "properties": {
            "references": {
              "$ref": "#/$defs/colourMap"
            },
            "subreferences": {
              "$ref": "#/$defs/colourMap"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "default_view": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Application-facing default graph view name."
    },
    "view_settings": {
      "type": "object",
      "additionalProperties": true,
      "description": "Opaque application-owned settings transported and written by archgraph-core."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "glob": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=.*\\S)[^\\r\\n]+$"
    },
    "pathRoot": {
      "type": "string",
      "pattern": "^[^*?\\r\\n]*$",
      "description": "Literal project-relative directory path. Empty or . normalizes to the project root; archgraph-core rejects absolute and escaping paths."
    },
    "layer": {
      "type": "object",
      "properties": {
        "display_name": {
          "type": "string",
          "description": "Application-facing layer name."
        },
        "path_root": {
          "$ref": "#/$defs/pathRoot",
          "description": "Literal directory path relative to the selected project root. Layer file and ignore globs are evaluated relative to this directory."
        },
        "ignored_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/glob"
          },
          "uniqueItems": true,
          "description": "Glob patterns ignored within this layer, relative to path_root."
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceGlob"
          },
          "uniqueItems": true,
          "description": "Candidate source globs evaluated relative to path_root. A matching file is enrolled only when it contains configured ArchGraph markers."
        },
        "markers": {
          "type": "object",
          "properties": {
            "ARCH_NODE": {
              "$ref": "#/$defs/markerList"
            },
            "ARCH_REFERENCE": {
              "$ref": "#/$defs/markerList"
            },
            "ARCH_SUBREFERENCE": {
              "$ref": "#/$defs/markerList"
            }
          },
          "additionalProperties": false,
          "description": "Concrete marker spellings accepted for this layer."
        }
      },
      "additionalProperties": false,
      "required": [
        "files"
      ]
    },
    "markerList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/marker"
      },
      "uniqueItems": true
    },
    "marker": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=.*\\S)[^:\\r\\n]+$"
    },
    "colourMap": {
      "type": "object",
      "propertyNames": {
        "minLength": 1,
        "pattern": "\\S"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "sourceGlob": {
      "allOf": [
        {
          "$ref": "#/$defs/glob"
        },
        {
          "not": {
            "const": ".archgraph"
          }
        }
      ]
    },
    "architectureLayer": {
      "type": "object",
      "properties": {
        "display_name": {
          "type": "string",
          "description": "Application-facing layer name."
        },
        "path_root": {
          "$ref": "#/$defs/pathRoot",
          "description": "Literal directory path relative to the selected project root. Layer file and ignore globs are evaluated relative to this directory."
        },
        "ignored_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/glob"
          },
          "uniqueItems": true,
          "description": "Glob patterns ignored within this layer, relative to path_root."
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceGlob"
          },
          "uniqueItems": true,
          "description": "Candidate source globs evaluated relative to path_root. A matching file is enrolled only when it contains configured ArchGraph markers."
        },
        "markers": {
          "type": "object",
          "properties": {
            "ARCH_NODE": {
              "$ref": "#/$defs/markerList"
            },
            "ARCH_REFERENCE": {
              "$ref": "#/$defs/markerList"
            },
            "ARCH_SUBREFERENCE": {
              "$ref": "#/$defs/markerList"
            }
          },
          "additionalProperties": false,
          "description": "Concrete marker spellings accepted for this layer."
        }
      },
      "additionalProperties": false
    }
  }
}
