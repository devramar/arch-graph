{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archgraph.dev/schema/project-configuration-v2.json",
  "title": "ArchGraph Project Configuration",
  "description": "Optional root .archgraph configuration consumed by archgraph-core.",
  "type": "object",
  "properties": {
    "ignored_paths": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/glob"
      },
      "uniqueItems": true
    },
    "layers": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/layer"
      },
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^\\S+$"
      },
      "properties": {
        "architecture": {
          "$ref": "#/$defs/architectureLayer"
        }
      }
    },
    "app_colours": {
      "type": "object",
      "properties": {
        "colour_overrides": {
          "type": "object",
          "properties": {
            "references": {
              "$ref": "#/$defs/colourMap"
            },
            "subreferences": {
              "$ref": "#/$defs/colourMap"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "default_view": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "view_settings": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "glob": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=.*\\S)[^\\r\\n]+$"
    },
    "layer": {
      "type": "object",
      "properties": {
        "display_name": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceGlob"
          },
          "uniqueItems": true
        },
        "markers": {
          "type": "object",
          "properties": {
            "ARCH_NODE": {
              "$ref": "#/$defs/markerList"
            },
            "ARCH_REFERENCE": {
              "$ref": "#/$defs/markerList"
            },
            "ARCH_SUBREFERENCE": {
              "$ref": "#/$defs/markerList"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "required": [
        "files"
      ]
    },
    "markerList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/marker"
      },
      "uniqueItems": true
    },
    "marker": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=.*\\S)[^:\\r\\n]+$"
    },
    "colourMap": {
      "type": "object",
      "propertyNames": {
        "minLength": 1,
        "pattern": "\\S"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "sourceGlob": {
      "allOf": [
        {
          "$ref": "#/$defs/glob"
        },
        {
          "not": {
            "const": ".archgraph"
          }
        }
      ]
    },
    "architectureLayer": {
      "type": "object",
      "properties": {
        "display_name": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceGlob"
          },
          "uniqueItems": true
        },
        "markers": {
          "type": "object",
          "properties": {
            "ARCH_NODE": {
              "$ref": "#/$defs/markerList"
            },
            "ARCH_REFERENCE": {
              "$ref": "#/$defs/markerList"
            },
            "ARCH_SUBREFERENCE": {
              "$ref": "#/$defs/markerList"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
