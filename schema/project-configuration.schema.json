{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archgraph.dev/schema/project-configuration-v1.json",
  "title": "ArchGraph Project Configuration",
  "description": "Optional root .archgraph configuration consumed by archgraph-core.",
  "type": "object",
  "properties": {
    "aliasing": {
      "type": "object",
      "properties": {
        "ARCHITECTURE.md": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/architectureFilename" }
        },
        "ARCH_NODE": { "$ref": "#/$defs/markerList" },
        "ARCH_REFERENCE": { "$ref": "#/$defs/markerList" },
        "ARCH_SUBREFERENCE": { "$ref": "#/$defs/markerList" }
      },
      "additionalProperties": false
    },
    "app_colours": {
      "type": "object",
      "properties": {
        "colour_overrides": {
          "type": "object",
          "properties": {
            "references": { "$ref": "#/$defs/colourMap" },
            "subreferences": { "$ref": "#/$defs/colourMap" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "default_view": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "view_settings": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "architectureFilename": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=.*\\S)[^/\\\\]+$",
      "not": {
        "enum": [".", "..", ".archgraph"]
      }
    },
    "markerList": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/marker" }
    },
    "marker": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=.*\\S)[^:\\r\\n]+$"
    },
    "colourMap": {
      "type": "object",
      "propertyNames": {
        "minLength": 1,
        "pattern": "\\S"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    }
  }
}
